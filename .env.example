# Data source for src/lib/api/*. "mock" (default) uses src/data/mock with simulated latency.
NEXT_PUBLIC_DATA_MODE=mock

# Public site URL, used for canonical URLs, hreflang, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp Business number, E.164 digits only (no "+"). Replace before launch.
NEXT_PUBLIC_WHATSAPP_NUMBER=8801000000000
